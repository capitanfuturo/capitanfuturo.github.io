---
import Layout from '../layouts/Layout.astro';
import Bio from '../components/Bio.astro';
import { getPublishedPosts, postSlug, tagSlug, formatDate, postExcerpt, PAGE_SIZE } from '../lib/posts';

const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);
---
<Layout title="Capitanfuturo" isRoot={true}>
  <Bio />
  <ol class="list-none p-0 m-0 space-y-10">
    {posts.map((post) => {
      const slug = postSlug(post.id);
      return (
        <li class="border-b border-gray-100 pb-10 last:border-0">
          <article itemscope itemtype="http://schema.org/Article">
            <header class="mb-2">
              <h2 class="text-xl font-bold m-0 mb-1">
                <a
                  href={`/${slug}/`}
                  class="text-gray-900 no-underline hover:underline"
                  itemprop="url"
                >
                  <span itemprop="headline">{post.data.title}</span>
                </a>
              </h2>
              <div class="text-sm text-gray-400 flex flex-wrap gap-2 items-center">
                <time datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
                {post.data.tags && post.data.tags.length > 0 && (
                  <span class="flex gap-1 flex-wrap">
                    {post.data.tags.map((tag) => (
                      <a
                        href={`/tags/${tagSlug(tag)}/`}
                        class="text-gray-400 hover:text-gray-700 no-underline"
                      >
                        [{tag}]
                      </a>
                    ))}
                  </span>
                )}
              </div>
            </header>
            <p class="text-base text-gray-500 mt-2 leading-relaxed">{postExcerpt(post.body)}</p>
          </article>
        </li>
      );
    })}
  </ol>
  <nav class="flex justify-between mt-12 pt-4 border-t border-gray-300">
    <span></span>
    {totalPages > 1 && (
      <a href="/2/" class="text-base text-gray-600 hover:underline">
        pagina successiva →
      </a>
    )}
  </nav>
</Layout>
