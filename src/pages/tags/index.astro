---
import Layout from '../../layouts/Layout.astro';
import Bio from '../../components/Bio.astro';
import { getPublishedPosts, tagSlug } from '../../lib/posts';

const allPosts = await getPublishedPosts();

const tagMap = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.data.tags ?? []) {
    tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
  }
}

const tags = [...tagMap.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---
<Layout title="Tutti i tag">
  <Bio />
  <article itemscope itemtype="http://schema.org/Article">
    <h1 class="text-3xl font-black mb-8" itemprop="headline">Tag</h1>
    <ul class="flex flex-wrap gap-3 list-none p-0 m-0">
      {tags.map(([tag, count]) => (
        <li>
          <a
            href={`/tags/${tagSlug(tag)}/`}
            class="inline-flex items-center gap-1 bg-blue-50 text-blue-800 px-3 py-1 rounded-full text-sm hover:bg-blue-100 no-underline"
          >
            {tag}
            <span class="text-blue-400 text-xs">({count})</span>
          </a>
        </li>
      ))}
    </ul>
  </article>
</Layout>
