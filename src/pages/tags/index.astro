---
import Layout from '../../layouts/Layout.astro';
import Bio from '../../components/Bio.astro';
import { getPublishedPosts, tagSlug } from '../../lib/posts';

const allPosts = await getPublishedPosts();

const tagMap = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.data.tags ?? []) {
    tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
  }
}

const tags = [...tagMap.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---
<Layout title="Tutti i tag">
  <Bio />
  <article itemscope itemtype="http://schema.org/Article">
    <h1 class="text-2xl font-bold mb-8" itemprop="headline">Tag</h1>
    <ul class="flex flex-wrap gap-3 list-none p-0 m-0">
      {tags.map(([tag, count]) => (
        <li>
          <a
            href={`/tags/${tagSlug(tag)}/`}
            class="text-base text-gray-600 hover:text-gray-900 no-underline"
          >
            [{tag}]<span class="text-gray-400 text-xs ml-0.5">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  </article>
</Layout>
