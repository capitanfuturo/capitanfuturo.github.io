---
import { Image } from 'astro:assets';
import profilePic from '../images/profile-pic.jpg';
---
<div class="flex items-start gap-4 mb-16">
  <Image
    src={profilePic}
    alt="Foto profilo Giuseppe Caliendo"
    width={48}
    height={48}
    class="min-w-[48px] grayscale"
  />
  <p class="m-0 text-base leading-relaxed text-gray-600">
    Scritto da <strong class="text-gray-900">Giuseppe Caliendo</strong> dall'Italia.
    {' '}
    <a href="https://twitter.com/capitanfuturo81" class="text-gray-600 hover:underline">[Twitter]</a>
    {' '}
    <a href="https://www.linkedin.com/in/giuseppecaliendo" class="text-gray-600 hover:underline">[LinkedIn]</a>
    {' '}
    <a href="https://github.com/capitanfuturo" class="text-gray-600 hover:underline">[Github]</a>
    {' '}
    <a href="/tags/" class="text-gray-600 hover:underline">[Tag]</a>
  </p>
</div>
